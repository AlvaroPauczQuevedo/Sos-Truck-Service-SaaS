# Porta do servidor HTTP
PORT=3000
# Segredo que assina os tokens de sessao. Precisa ser SEU e ter ao menos 32
# caracteres - quem souber este valor fabrica uma sessao de administrador.
# Gere o seu com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Se ficar em branco, o sistema gera um sozinho e guarda em data/.segredo-sessao.
JWT_SECRET=
# Tempo de expiracao da sessao
JWT_EXPIRES=12h
# Caminho do banco de dados SQLite
DB_PATH=./data/sos-truck.db
# Pasta de armazenamento das fotos originais
UPLOAD_DIR=./data/uploads
# Tamanho maximo por foto (bytes) - padrao 15MB
MAX_UPLOAD_BYTES=15728640
# Ligue APENAS se houver um proxy real na frente (Nginx, Apache, Cloudflare).
# Com isto ligado sem proxy, qualquer um forja o X-Forwarded-For e escapa do
# bloqueio de forca bruta do login. Vazio = sem proxy.
TRUST_PROXY=
# Teto de requisicoes por IP a cada minuto na API
LIMITE_REQ_MINUTO=300
